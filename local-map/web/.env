SKIP_PREFLIGHT_CHECK=true
VITE_VALHALLA_URL=/valhalla
VITE_NOMINATIM_URL=/disabled-geocoding
VITE_TILE_SERVER_URL="/api/v1/tiles/{z}/{x}/{y}.png"
VITE_CENTER_COORDS="22.526967288038794,113.38995276699997"

