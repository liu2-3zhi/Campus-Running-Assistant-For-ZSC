# Copy to mysql.env, set the external host and application credentials, and keep mysql.env out of Git.
# Used only with docker-compose.mysql.yml; base deployments remain file-backed.
MYSQL_HOST=database.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=campus_running
MYSQL_USER=campus_app
MYSQL_PASSWORD=replace-with-a-unique-app-password
MYSQL_TABLE_PREFIX=app_
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=15
MYSQL_WRITE_TIMEOUT=15
# Optional for an externally configured TLS server; mount the CA at this path.
# MYSQL_SSL_CA=/run/secrets/mysql-ca.pem
